      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select coalesce(sum(open_count), 0) as current_wip\nfrom (\n  select open_count\n  from mart.v_kpi_ib_wip_status\n  where warehouse_key in (${warehouse:csv})\n    and client_key in (${client:csv})\n  union all\n  select open_count\n  from mart.v_kpi_ob_wip_status\n  where warehouse_key in (${warehouse:csv})\n    and client_key in (${client:csv})\n) x;",
          "refId": "A"
        }
      ],
      "title": "Current WIP",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select\n  d.date::timestamp as \"time\",\n  sum(k.receipts_created)::numeric as \"Receipts/day\"\nfrom mart.v_kpi_ib_daily k\njoin mart.dim_date d on d.date_key = k.date_key\nwhere d.date between $__timeFrom()::date and $__timeTo()::date\n  and k.warehouse_key in (${warehouse:csv})\n  and k.client_key in (${client:csv})\ngroup by 1\norder by 1;",
          "refId": "A"
        },
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select\n  d.date::timestamp as \"time\",\n  sum(k.orders_created)::numeric as \"Orders/day\"\nfrom mart.v_kpi_ob_daily k\njoin mart.dim_date d on d.date_key = k.date_key\nwhere d.date between $__timeFrom()::date and $__timeTo()::date\n  and k.warehouse_key in (${warehouse:csv})\n  and k.client_key in (${client:csv})\ngroup by 1\norder by 1;",
          "refId": "B"
        },
        {
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "select\n  d.date::timestamp as \"time\",\n  (avg(k.otd_rate) * 100.0)::numeric as \"OTD%/day\"\nfrom mart.v_kpi_ob_daily k\njoin mart.dim_date d on d.date_key = k.date_key\nwhere d.date between $__timeFrom()::date and $__timeTo()::date\n  and k.warehouse_key in (${warehouse:csv})\n  and k.client_key in (${client:csv})\ngroup by 1\norder by 1;",
          "refId": "C"
        }
      ],
      "title": "Receipts, Orders, OTD% by Day",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "${DS_POSTGRES}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select\n  f.order_id,\n  f.so_code,\n  w.warehouse_id,\n  c.client_id,\n  f.status,\n  f.expected_delivery_date,\n  f.actual_delivery_date,\n  f.delivery_delay_days\nfrom mart.fact_ob_order f\nleft join mart.dim_warehouse w on w.warehouse_key = f.warehouse_key\nleft join mart.dim_client c on c.client_key = f.client_key\nwhere f.created_at >= now() - interval '7 days'\n  and f.delivery_delay_days > 0\n  and f.warehouse_key in (${warehouse:csv})\n  and f.client_key in (${client:csv})\norder by f.delivery_delay_days desc nulls last\nlimit 50;",
          "refId": "A"
        }
      ],
      "title": "Top Late Orders (Last 7d)",
      "type": "table"
    }
  ],
