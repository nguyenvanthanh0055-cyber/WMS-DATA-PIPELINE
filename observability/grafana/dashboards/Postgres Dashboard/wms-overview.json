          "rawSql": "select count(*) as total_ob_orders_7d\nfrom mart.fact_ob_order f\nwhere f.created_at >= now() - interval '7 days'\n  and f.warehouse_key in (${warehouse:csv})\n  and f.client_key in (${client:csv});",
          "refId": "A"
