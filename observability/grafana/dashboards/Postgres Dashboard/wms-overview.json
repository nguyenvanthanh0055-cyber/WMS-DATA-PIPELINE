      "targets": [
        {
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select count(*) as total_ib_receipts_7d\nfrom mart.fact_ib_receipt f\nwhere f.created_at >= now() - interval '7 days'\n  and f.warehouse_key in (${warehouse:csv})\n  and f.client_key in (${client:csv});",
          "refId": "A"
        }
      ],
      "title": "Total IB Receipts (7d)",
      "type": "stat"
